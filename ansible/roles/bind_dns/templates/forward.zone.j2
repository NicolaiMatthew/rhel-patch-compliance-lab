$TTL 3600
@   IN SOA dns01.{{ lab_domain }}. hostmaster.{{ lab_domain }}. (
        {{ dns_serial }} ; serial
        3600       ; refresh
        900        ; retry
        604800     ; expire
        300 )      ; negative TTL
    IN NS dns01.{{ lab_domain }}.
{% for name, ip in lab_hosts.items() %}
{{ name }}    IN A    {{ ip }}
{% endfor %}
